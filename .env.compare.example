# Optional separate direct-API comparison. Copy to .env.compare; never commit its key.
# Current comparison uses gpt-6-luna through the existing Codex login, so this is not required.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Set one exact available model ID ending in :free; do not use a random free router.
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=600
LLM_TOKEN_FIELD=max_tokens
LLM_SEND_TEMPERATURE=true
LLM_TIMEOUT=90
